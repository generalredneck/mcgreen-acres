
# Ignore backup directory on production
private
backups
*.sql
*.sql.gz

# Ignore sensitive information
/web/sites/*/settings.local.php
/web/sites/*/live.txt

# Ignore Drupal's file directory
/web/sites/*/files/

# Ignore SimpleTest multi-site environment.
/web/sites/simpletest
/web/modules/contrib/**/tests
/web/modules/contrib/**/README.*
# Ignore files generated by PhpStorm
/.idea/

# Ignore .env files as they are personal
/.env

.lando.local.yml
.vscode
# Claude Code: the shared skill, the security-watch script and .claude/settings.json are tracked.
# Personal settings, worktrees, caches and the watcher's runtime state are not.
.claude/settings.local.json
.claude/**/__pycache__/
.claude/worktrees/
.claude/skills/*/cache/
.claude/security-watch/*
!.claude/security-watch/watch.py
.playwright-mcp

# Stray npm install at repo root (no package.json here)
/node_modules/

# Local theme/db backup archives
/*.gz

# Local design mockups (remove this line if you want them versioned)
/mockups/
content-drafts
