<?xml version="1.0" encoding="UTF-8"?>
<ruleset name="Drupal Project">
    <arg name="extensions" value="inc,info,install,module,php,profile,test,theme" />
    <file>./public_html/modules/custom</file>
    <file>./public_html/themes/custom</file>
    <exclude-pattern>vendor</exclude-pattern>
    <exclude-pattern>contrib</exclude-pattern>
    <exclude-pattern>tests</exclude-pattern>
    <exclude-pattern>pattern-lab</exclude-pattern>
    <exclude-pattern>node_modules</exclude-pattern>
    <exclude-pattern>*.old/*</exclude-pattern>
    <rule ref="Drupal"/>
    <rule ref="PHPCompatibility"/>
    <config name="testVersion" value="8.5"/>
</ruleset>
