 /**
@@ -758,3 +759,34 @@ function simplenews_update_940001() {
   $config_storage = \Drupal::service('config.storage');
   $config_storage->write($config_name, $source->read($config_name));
 }
+
+/**
+ * Add a GUI for the subscriber history entity (list, access, indexes).
+ */
+function simplenews_update_940002() {
+  $definition_update_manager = \Drupal::entityDefinitionUpdateManager();
+
+  // Pick up the new handlers (list builder, access, views data, storage schema),
+  // the collection link and the mail / (mail, timestamp) indexes declared on the
+  // entity type.
+  $entity_type = \Drupal::entityTypeManager()->getDefinition('simplenews_subscriber_history')
+    ->setHandlerClass('storage_schema', SubscriberHistoryStorageSchema::class);
+  $definition_update_manager->updateEntityType($entity_type);
+
+  // Install the bundled view that overrides the default listing, unless the site
+  // already has a view with this name. New installs pick it up as optional
+  // config; this covers sites updating from an earlier release.
+  if (\Drupal::moduleHandler()->moduleExists('views')) {
+    $view_id = 'simplenews_subscriber_history';
+    $view_storage = \Drupal::entityTypeManager()->getStorage('view');
+    if (!$view_storage->load($view_id)) {
+      $config_path = \Drupal::moduleHandler()->getModule('simplenews')->getPath() . '/config/optional';
+      $source = new FileStorage($config_path);
+      if ($values = $source->read('views.view.' . $view_id)) {
+        $view_storage->create($values)->save();
+      }
+    }
+  }
+
+  return (string) t('Installed the subscriber history GUI at /admin/people/simplenews/history.');
+}
