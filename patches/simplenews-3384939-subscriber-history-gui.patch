+<?php
+
+namespace Drupal\simplenews;
+
+use Drupal\views\EntityViewsData;
+
+/**
+ * Provides the views data for the subscriber history entity type.
+ */
+class SubscriberHistoryViewsData extends EntityViewsData {
+
+  /**
+   * {@inheritdoc}
+   */
+  public function getViewsData() {
+    $data = parent::getViewsData();
+
+    // Render "source" via SubscriberHistory::getSource() instead of showing
+    // the raw "route:*" token.
+    $data['simplenews_subscriber_history']['source']['field']['id'] = 'simplenews_subscriber_history_source';
+
+    // Filter the subscribed-newsletter set by newsletter, like the subscriber
+    // list does.
+    $data['simplenews_subscriber_history__subscriptions']['subscriptions_target_id']['filter'] = [
+      'id' => 'in_operator',
+      'options callback' => 'simplenews_newsletter_list',
+      'allow empty' => TRUE,
+    ];
+
+    // The per-subscriber history page passes the address as an argument.
+    $data['simplenews_subscriber_history']['mail']['argument'] = [
+      'id' => 'string',
+    ];
+
+    return $data;
+  }
+
+}
diff --git a/tests/src/Functional/SubscriberHistoryTest.php b/tests/src/Functional/SubscriberHistoryTest.php
new file mode 100644
index 0000000..d59bd31
--- /dev/null
+++ b/tests/src/Functional/SubscriberHistoryTest.php
@@ -0,0 +1,129 @@
+<?php
+
+namespace Drupal\Tests\simplenews\Functional;
+
+use Drupal\Core\Database\Database;
+use Drupal\simplenews\Entity\Newsletter;
+use Drupal\simplenews\Entity\Subscriber;
+use Drupal\simplenews\SubscriberInterface;
+
+/**
+ * Tests the subscriber history GUI (list page, access, indexes).
+ *
+ * @group simplenews
+ */
+class SubscriberHistoryTest extends SimplenewsTestBase {
+
+  /**
+   * {@inheritdoc}
+   */
+  protected static $modules = ['simplenews', 'simplenews_test', 'block', 'views'];
+
+  /**
+   * The collection route path.
+   */
+  protected const PATH = 'admin/people/simplenews/history';
+
+  /**
+   * {@inheritdoc}
+   */
+  protected function setUp(): void {
+    parent::setUp();
+    Newsletter::create(['id' => 'weekly', 'name' => 'Weekly'])->save();
+  }
+
+  /**
+   * Records history for an address by saving a confirmed subscriber.
+   */
+  protected function recordHistory(string $mail, array $newsletters): SubscriberInterface {
+    $subscriber = Subscriber::create([
+      'mail' => $mail,
+      'status' => SubscriberInterface::ACTIVE,
+      'subscriptions' => $newsletters,
+    ]);
+    $subscriber->save();
+    return $subscriber;
+  }
+
+  /**
+   * The list page is permission gated.
+   */
+  public function testCollectionAccess(): void {
+    $this->drupalGet(self::PATH);
+    $this->assertSession()->statusCodeEquals(403);
+
+    $this->drupalLogin($this->drupalCreateUser(['access administration pages']));
+    $this->drupalGet(self::PATH);
+    $this->assertSession()->statusCodeEquals(403);
+
+    $this->drupalLogin($this->drupalCreateUser(['view simplenews subscriptions']));
+    $this->drupalGet(self::PATH);
+    $this->assertSession()->statusCodeEquals(200);
+
+    $this->drupalLogin($this->drupalCreateUser(['administer simplenews subscriptions']));
+    $this->drupalGet(self::PATH);
+    $this->assertSession()->statusCodeEquals(200);
+    $this->assertSession()->pageTextContains('Subscription history');
+    // Tab is shown alongside the subscriber list tabs.
+    $this->assertSession()->linkExists('History');
+  }
+
+  /**
+   * Subscribe / add / unsubscribe events all appear on the page.
+   */
+  public function testHistoryRowsRendered(): void {
+    $this->recordHistory('rows@example.com', ['default']);
+    $subscriber = Subscriber::loadByMail('rows@example.com');
+    $subscriber->subscribe('weekly');
+    $subscriber->save();
+    $subscriber->unsubscribe('default');
+    $subscriber->save();
+
+    $this->drupalLogin($this->drupalCreateUser(['administer simplenews subscriptions']));
+    $this->drupalGet(self::PATH);
+    $this->assertSession()->statusCodeEquals(200);
+    $this->assertSession()->pageTextContains('rows@example.com');
+    // Three recorded events for this address.
+    $this->assertSession()->elementsCount('css', 'td.views-field-mail', 3);
+  }
+
+  /**
+   * A routeless (programmatic) save is shown as "Programmatic", not a fatal.
+   */
+  public function testProgrammaticSourceIsRendered(): void {
+    $this->recordHistory('cli@example.com', ['default']);
+
+    $this->drupalLogin($this->drupalCreateUser(['administer simplenews subscriptions']));
+    $this->drupalGet(self::PATH);
+    $this->assertSession()->pageTextContains('Programmatic');
+  }
+
+  /**
+   * The lookup indexes declared by the storage schema are created.
+   */
+  public function testIndexesExist(): void {
+    $schema = Database::getConnection()->schema();
+    $this->assertTrue($schema->indexExists('simplenews_subscriber_history', 'simplenews_subscriber_history__mail'));
+    $this->assertTrue($schema->indexExists('simplenews_subscriber_history', 'simplenews_subscriber_history__mail_timestamp'));
+  }
+
+  /**
+   * The access handler allows viewing by permission but forbids modification.
+   */
+  public function testEntityAccessHandler(): void {
+    $this->recordHistory('acc@example.com', ['default']);
+    $records = \Drupal::entityTypeManager()
+      ->getStorage('simplenews_subscriber_history')
+      ->loadByProperties(['mail' => 'acc@example.com']);
+    $record = reset($records);
+
+    $viewer = $this->drupalCreateUser(['view simplenews subscriptions']);
+    $this->assertTrue($record->access('view', $viewer));
+    $this->assertFalse($record->access('update', $viewer));
+    $this->assertFalse($record->access('delete', $viewer));
+
+    $nobody = $this->drupalCreateUser(['access administration pages']);
+    $this->assertFalse($record->access('view', $nobody));
+  }
+
+}
