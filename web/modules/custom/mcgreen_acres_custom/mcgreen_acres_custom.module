<?php

/**
 * @file
 * Contains mcgreen_acres_custom.module.
 */

use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\user\UserInterface;

/**
 * Newsletter that all accounts should be auto-subscribed to.
 */
const MCGREEN_ACRES_CUSTOM_DEFAULT_NEWSLETTER = 'default';

/**
 * Implements hook_help().
 */
function mcgreen_acres_custom_help($route_name, RouteMatchInterface $route_match) {
  switch ($route_name) {
    // Main module help for the mcgreen_acres_custom module.
    case 'help.page.mcgreen_acres_custom':
      $output = '';
      $output .= '<h3>' . t('About') . '</h3>';
      $output .= '<p>' . t('Custom functionality for McGreen Acres site.') . '</p>';
      return $output;

    default:
  }
}

/**
 * Implements hook_theme().
 */
function mcgreen_acres_custom_theme() {
  return [
    'mcgreen_acres_custom' => [
      'render element' => 'children',
    ],
    'search_block' => [
      'variables' => [
        'search_value' => '',
      ],
      'render element' => 'children',
    ],
  ];
}

/**
 * Implements hook_library_info_alter().
 *
 * The theme's JS (bootstrap, swiper, isotope, nice-select, jquery.appear,
 * etc.) targets the jQuery 3 API and breaks under Drupal core's bundled
 * jQuery 4. Overriding the core/jquery library definition itself, rather
 * than trying to strip it from already-attached libraries (as the
 * jquery_downgrade module did), works regardless of whether core/jquery is
 * pulled in by the theme, a block, or a contrib module: there's nothing to
 * strip later because core/jquery already resolves to jQuery 3.
 */
function mcgreen_acres_custom_library_info_alter(&$libraries, $extension) {
  if ($extension === 'core' && isset($libraries['jquery']) && \Drupal::theme()->getActiveTheme()->getName() === 'mcgreen_acres_theme') {
    $libraries['jquery']['version'] = '3.6.4';
    $libraries['jquery']['js'] = [
      'https://code.jquery.com/jquery-3.6.4.min.js' => ['type' => 'external', 'weight' => -20],
    ];
  }
}

/**
 * Implements hook_user_insert().
 *
 * Subscribes every new account to the default newsletter.
 */
function mcgreen_acres_custom_user_insert(UserInterface $account) {
  if ($account->getEmail()) {
    \Drupal::service('simplenews.subscription_manager')->subscribe(
      $account->getEmail(),
      MCGREEN_ACRES_CUSTOM_DEFAULT_NEWSLETTER,
      $account->getPreferredLangcode()
    );
  }
}

/**
 * Implements hook_user_update().
 *
 * Unsubscribes accounts from the default newsletter when they are blocked
 * or canceled (account cancellation sets the status to blocked before any
 * eventual deletion).
 */
function mcgreen_acres_custom_user_update(UserInterface $account) {
  $original = $account->original ?? NULL;
  if ($original && $original->isActive() && $account->isBlocked() && $account->getEmail()) {
    \Drupal::service('simplenews.subscription_manager')->unsubscribe(
      $account->getEmail(),
      MCGREEN_ACRES_CUSTOM_DEFAULT_NEWSLETTER
    );
  }
}

/**
 * Implements hook_user_delete().
 *
 * Unsubscribes accounts from the default newsletter when they are deleted.
 */
function mcgreen_acres_custom_user_delete(UserInterface $account) {
  if ($account->getEmail()) {
    \Drupal::service('simplenews.subscription_manager')->unsubscribe(
      $account->getEmail(),
      MCGREEN_ACRES_CUSTOM_DEFAULT_NEWSLETTER
    );
  }
}

/**
 * Implements hook_field_widget_single_element_form_alter().
 */
function mcgreen_acres_custom_field_widget_single_element_form_alter(&$element, FormStateInterface $form_state, $context) {
  $widget_id = $context['widget']->getPluginId();
  if (in_array($widget_id, ['entity_reference_autocomplete', 'entity_reference_autocomplete_tags'])) {
    if (isset($element['target_id']['#maxlength']) && $element['target_id']['#maxlength'] <= 1024) {
      $element['target_id']['#maxlength'] = 4096;
    }
  }
}
