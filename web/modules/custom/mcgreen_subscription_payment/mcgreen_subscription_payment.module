<?php

/**
 * @file
 * Contains hook implementations for the mcgreen_subscription_payment module.
 */

use Drupal\commerce_order\Entity\OrderInterface;
use Drupal\commerce_payment\Plugin\Commerce\PaymentGateway\ManualPaymentGatewayInterface;
use Drupal\Core\Entity\EntityFormInterface;
use Drupal\Core\Entity\EntityTypeInterface;
use Drupal\Core\Field\BaseFieldDefinition;
use Drupal\Core\Form\FormStateInterface;
use Drupal\Core\Url;

/**
 * Implements hook_entity_base_field_info().
 *
 * Adds a manual_payment_gateway reference to subscriptions so that cash/check
 * subscriptions can store which manual gateway they belong to without needing
 * a stored payment method entity.
 */
function mcgreen_subscription_payment_entity_base_field_info(EntityTypeInterface $entity_type) {
  if ($entity_type->id() !== 'commerce_subscription') {
    return [];
  }

  $fields['manual_payment_gateway'] = BaseFieldDefinition::create('entity_reference')
    ->setLabel(t('Manual payment gateway'))
    ->setDescription(t('The manual payment gateway (e.g. cash, check) for this subscription. Used when no stored payment method is available.'))
    ->setSetting('target_type', 'commerce_payment_gateway')
    ->setSetting('handler', 'default')
    ->setDisplayOptions('form', [
      'type' => 'options_select',
      'weight' => 2,
    ])
    ->setDisplayConfigurable('form', TRUE)
    ->setDisplayConfigurable('view', TRUE);

  return $fields;
}

/**
 * Implements hook_form_alter().
 *
 * Filters the manual_payment_gateway select to only show manual gateways,
 * and hides it on the customer-facing subscription form.
 */
function mcgreen_subscription_payment_form_alter(array &$form, FormStateInterface $form_state, $form_id) {
  $form_object = $form_state->getFormObject();
  if (!($form_object instanceof EntityFormInterface)) {
    return;
  }
  $entity = $form_object->getEntity();
  if ($entity->getEntityTypeId() !== 'commerce_subscription') {
    return;
  }

  // Hide this field entirely on the customer-facing form.
  if ($form_object->getOperation() === 'customer') {
    if (isset($form['manual_payment_gateway'])) {
      $form['manual_payment_gateway']['#access'] = FALSE;
    }
    return;
  }

  // Filter the options widget to only include active manual gateways.
  if (!isset($form['manual_payment_gateway']['widget'])) {
    return;
  }

  $gateway_storage = \Drupal::entityTypeManager()->getStorage('commerce_payment_gateway');
  $all_gateways = $gateway_storage->loadByProperties(['status' => TRUE]);

  $manual_ids = [];
  /** @var \Drupal\commerce_payment\Entity\PaymentGatewayInterface $gateway */
  foreach ($all_gateways as $gateway) {
    if ($gateway->getPlugin() instanceof ManualPaymentGatewayInterface) {
      $manual_ids[$gateway->id()] = TRUE;
    }
  }

  $widget = &$form['manual_payment_gateway']['widget'];
  if (isset($widget['#options'])) {
    foreach (array_keys($widget['#options']) as $key) {
      if ($key !== '_none' && !isset($manual_ids[$key])) {
        unset($widget['#options'][$key]);
      }
    }
  }
}

/**
 * Implements hook_theme().
 */
function mcgreen_subscription_payment_theme() {
  return [
    'commerce_recurring_payment_due' => [
      'variables' => [
        'order_entity' => NULL,
        'totals' => [],
        'billing_information' => NULL,
      ],
    ],
  ];
}

/**
 * Implements hook_preprocess_HOOK() for commerce_order.
 *
 * Warns staff on the admin order page when placing a draft order now would not
 * create its subscription.
 */
function mcgreen_subscription_payment_preprocess_commerce_order(array &$variables) {
  /** @var \Drupal\commerce_order\Entity\OrderInterface $order */
  $order = $variables['elements']['#commerce_order'];
  if ($variables['elements']['#view_mode'] !== 'admin') {
    return;
  }
  $titles = _mcgreen_subscription_payment_items_needing_payment($order);
  if (!$titles) {
    return;
  }

  $add_payment_url = Url::fromRoute('entity.commerce_payment.add_form', [
    'commerce_order' => $order->id(),
  ]);

  // Keep Commerce's own draft warning and show this one below it.
  $variables['draft_warning'] = [
    'commerce' => $variables['draft_warning'] ?? [],
    'subscription_payment' => [
      '#type' => 'container',
      '#attributes' => [
        'class' => ['messages', 'messages--warning', 'no-print'],
        'role' => 'alert',
      ],
      'content' => [
        '#type' => 'container',
        '#attributes' => ['class' => ['messages__content']],
        'summary' => [
          '#type' => 'html_tag',
          '#tag' => 'p',
          '#value' => t('<strong>Add a payment before you place this order.</strong> If you place it now, no subscription will be created for: @items.', [
            '@items' => implode(', ', $titles),
          ]),
        ],
        'steps' => [
          '#theme' => 'item_list',
          '#list_type' => 'ol',
          '#items' => [
            t('While the order is still a draft, <a href=":url">add a payment</a>. For cash, check or another offline method, add that payment too, even if you have not received the money yet (leave "Mark as received" unchecked).', [
              ':url' => $add_payment_url->toString(),
            ]),
            t('Come back to this page and click <em>Place order</em>.'),
          ],
        ],
      ],
    ],
  ];
}

/**
 * Lists the subscription items that placing the order now would skip.
 *
 * Mirrors the conditions in OrderSubscriber::onPlace(), which creates no
 * subscription when the order has neither a payment method nor a manual
 * payment gateway and the billing schedule does not allow trials.
 *
 * @param \Drupal\commerce_order\Entity\OrderInterface $order
 *   The order.
 *
 * @return string[]
 *   The affected order item titles. Empty if the order is not a draft, or if
 *   placing it would create every subscription it should.
 */
function _mcgreen_subscription_payment_items_needing_payment(OrderInterface $order): array {
  if ($order->bundle() === 'recurring' || $order->getState()->getId() !== 'draft') {
    return [];
  }
  if (!$order->get('payment_method')->isEmpty()) {
    return [];
  }
  /** @var \Drupal\commerce_payment\Entity\PaymentGatewayInterface|null $gateway */
  $gateway = $order->get('payment_gateway')->entity;
  if ($gateway && $gateway->getPlugin() instanceof ManualPaymentGatewayInterface) {
    return [];
  }

  $titles = [];
  foreach ($order->getItems() as $order_item) {
    $variation = $order_item->getPurchasedEntity();
    if (!$variation || !$variation->hasField('subscription_type') ||
      $variation->get('subscription_type')->isEmpty() ||
      $variation->get('billing_schedule')->isEmpty()) {
      continue;
    }
    /** @var \Drupal\commerce_recurring\Entity\BillingScheduleInterface $billing_schedule */
    $billing_schedule = $variation->get('billing_schedule')->entity;
    if (!$billing_schedule->getPlugin()->allowTrials()) {
      $titles[] = $order_item->getTitle();
    }
  }
  return $titles;
}
