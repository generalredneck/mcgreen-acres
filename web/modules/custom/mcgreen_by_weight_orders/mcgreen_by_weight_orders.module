<?php

/**
 * @file
 * Hooks for by-weight order handling.
 */

use Drupal\commerce_product\Entity\ProductVariationInterface;
use Drupal\mcgreen_by_weight_orders\ByWeightOrderCharger;
use Drupal\views\Plugin\views\query\QueryPluginBase;
use Drupal\views\ViewExecutable;

/**
 * Implements hook_ENTITY_TYPE_presave() for commerce_product_variation.
 *
 * A by-weight variation's price is the most a customer can be charged: the
 * heaviest weight in its range times the rate per lb. Compute it on every
 * save so the stored price (shown in the catalog, cart and search index and
 * authorized at checkout) can never disagree with the rate and max weight.
 */
function mcgreen_by_weight_orders_commerce_product_variation_presave(ProductVariationInterface $variation) {
  if ($variation->bundle() !== 'by_weight') {
    return;
  }
  if ($variation->get('field_rate_per_lb')->isEmpty() || $variation->get('field_max_weight')->isEmpty()) {
    return;
  }
  $rate = $variation->get('field_rate_per_lb')->first()->toPrice();
  $max_weight = (string) $variation->get('field_max_weight')->value;
  $variation->setPrice(\Drupal::service('commerce_price.rounder')->round($rate->multiply($max_weight)));
}

/**
 * Implements hook_views_query_alter().
 *
 * The "To weigh" view lists orders with a by-weight item that still needs
 * attention: an item with no packed weight yet, or a card order that was
 * authorized on the by-weight gateway but never actually charged (the capture
 * failed after the weights were saved, or the hold was voided or expired).
 * "Charged" means any completed payment, so an order stops being listed once
 * it has been paid some other way too. Joining the order items would return an
 * order once per matching item (and Views selects each item's ID, so DISTINCT
 * can't collapse them), so the condition is a correlated subquery on the order
 * instead.
 */
function mcgreen_by_weight_orders_views_query_alter(ViewExecutable $view, QueryPluginBase $query) {
  if ($view->id() !== 'commerce_orders_to_weigh') {
    return;
  }
  $query->addWhereExpression(0, 'EXISTS (
    SELECT 1
    FROM {commerce_order__order_items} oi
    INNER JOIN {commerce_order_item} i ON i.order_item_id = oi.order_items_target_id
    LEFT JOIN {commerce_order_item__field_packed_weight} w ON w.entity_id = i.order_item_id
    WHERE oi.entity_id = commerce_order.order_id
      AND oi.deleted = 0
      AND i.type = :by_weight_type
      AND (
        w.field_packed_weight_value IS NULL
        OR (
          EXISTS (
            SELECT 1 FROM {commerce_payment} held
            WHERE held.order_id = commerce_order.order_id AND held.payment_gateway = :gateway
          )
          AND NOT EXISTS (
            SELECT 1 FROM {commerce_payment} paid
            WHERE paid.order_id = commerce_order.order_id
              AND paid.state IN (:paid_completed, :paid_partially_refunded, :paid_refunded)
          )
        )
      )
  )', [
    ':by_weight_type' => ByWeightOrderCharger::ORDER_ITEM_TYPE,
    ':gateway' => ByWeightOrderCharger::GATEWAY_ID,
    ':paid_completed' => 'completed',
    ':paid_partially_refunded' => 'partially_refunded',
    ':paid_refunded' => 'refunded',
  ]);
}
