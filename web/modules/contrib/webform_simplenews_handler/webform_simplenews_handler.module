<?php

/**
 * @file
 * Drupal 10 compatibility wrappers and public callbacks.
 */

use Drupal\Core\Routing\RouteMatchInterface;
use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\webform_simplenews_handler\Hook\WebformSimplenewsHandlerHooks;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function webform_simplenews_handler_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(WebformSimplenewsHandlerHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function webform_simplenews_handler_theme() {
  return \Drupal::service(WebformSimplenewsHandlerHooks::class)->theme();
}
