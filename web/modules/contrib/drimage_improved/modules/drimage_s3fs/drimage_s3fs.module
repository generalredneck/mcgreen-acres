<?php

/**
 * @file
 * Drimage S3fs module.
 */

use Drupal\Core\Hook\Attribute\LegacyHook;
use Drupal\drimage_s3fs\Hook\DrimageS3fsHooks;
use Drupal\Core\Routing\RouteMatchInterface;

/**
 * Implements hook_help().
 */
#[LegacyHook]
function drimage_s3fs_help($route_name, RouteMatchInterface $route_match) {
  return \Drupal::service(DrimageS3fsHooks::class)->help($route_name, $route_match);
}

/**
 * Implements hook_theme().
 */
#[LegacyHook]
function drimage_s3fs_theme() {
  return \Drupal::service(DrimageS3fsHooks::class)->theme();
}

/**
 * Implements hook_library_info_alter().
 */
#[LegacyHook]
function drimage_s3fs_library_info_alter(&$libraries, $extension) {
  \Drupal::service(DrimageS3fsHooks::class)->libraryInfoAlter($libraries, $extension);
}
